# Copy these into Vercel (Project → Settings → Environment Variables)
# or Netlify (Site configuration → Environment variables). Never commit real values.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_FROM="AQ Pay <hello@aqpay.services>"
CONTACT_TO=hello@aqpay.services
# CONTACT_AUTOREPLY=false   # uncomment to stop the confirmation email to the sender

# Optional: register every enquiry as a lead in the sales portal (Settings → Website enquiries there).
# The address is shown in the portal; the key is shown once when the website is added. Set both, then redeploy.
# SALES_ENQUIRY_URL=https://your-sales-portal.example/api/public/sales/enquiries
# SALES_ENQUIRY_KEY=enq_xxxxxxxxxxxxxxxxxxxx
# The same two variables run the chat box (README, "Chat"). It is switched on in the portal, not here.
